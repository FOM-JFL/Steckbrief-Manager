# Datenbank-Konfiguration (Werte hier eintragen)
DB_HOST=mariadb.bcw-intern.local
DB_USER=
DB_PASS=
DB_NAME=bcw_allgemein

# LDAP/AD-Konfiguration
LDAP_SERVER=ldap://bcw-intern.local
LDAP_DOMAIN=bcw-intern.local
LDAP_BASE_DN=DC=bcw-intern,DC=local

# JWT-Konfiguration (PFLICHT: sicheres Secret setzen!)
JWT_SECRET=
JWT_EXPIRY_HOURS=8

# Erster Admin (AD-Username, wird beim ersten Login automatisch Admin)
INITIAL_ADMIN=

# Flask Debug-Modus (nur lokal auf 1 setzen)
FLASK_DEBUG=0

# Statischer Server Port
PORT=6111
DB_NAME=bcw_allgemein
